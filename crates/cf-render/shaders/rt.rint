#version 460
#extension GL_EXT_ray_tracing : require

// Trail tube: a round tube around the trail polyline, one AABB per segment.
// Primitive i is the segment from points[i] to points[i + 1].
layout(set = 0, binding = 2, std430) readonly buffer TrailPoints {
    vec4 points[]; // xyz = position, w = unused
} trail;

layout(push_constant) uniform PushConstants {
    vec4 camera_pos;  // xyz = position, w = viewport X offset (pixels)
    mat4 inv_view_proj;
    vec4 params;      // x = trail tail fade value, y = pixel size per metre of ray path, z = unused, w = viewport Y offset (pixels)
    vec4 ball_pos;    // xyz = ball center, w = trail fade distance (meters)
} pc;

// What the trail closest-hit (rt_trail.rchit) needs to colour the hit.
struct TubeHit {
    float height;   // world height of the closest point on the trail axis
    float fade;     // tracer fade value t there (1 at the ball)
    float rel_dist; // ray-to-axis distance / tube radius, in [0, 1)
    float rel_edge; // width of the soft edge / tube radius, in (0, 1]
    float weight;   // brightness of the tip taper where the width cannot taper
};
hitAttributeEXT TubeHit hit;

// Radius of the raster tracer's bright core: its ribbon reaches ball_radius
// either side of the trail (cf-scene `generate_trail_glow`).
const float TUBE_RADIUS = 0.021335;

// The tube is never thinner on screen than the raster tracer's 2 px centre
// line: its radius is at least this many pixels (half the line plus half the
// one-pixel soft edge, so the half-opacity width is 2 px).
const float TUBE_MIN_RADIUS_PX = 1.5;

// Upper bound of the radius in metres. Must equal TRAIL_TUBE_MAX_RADIUS in
// rt_pipeline.rs: the segment AABBs are padded by it.
const float TUBE_MAX_RADIUS = 1.0;

// Fraction of the radius over which the tube fades out at its edge: 0 is a
// hard edge, 1 fades all the way from the axis. The edge is at least one
// pixel wide, so the tube stays anti-aliased when it is thin.
const float TUBE_SOFTNESS = 0.5;

// Tracer fade value over the first TIP_TAPER of t the raster ribbon widens
// from nothing to full width.
const float TIP_TAPER = 0.15;

// Closest approach of the ray o + t·dir (dir unit length) to the segment
// a → b: x = distance, y = ray parameter t, and the closest segment point
// in `q` (exactly a or b when the closest point is an end).
vec2 closest_approach(vec3 o, vec3 dir, vec3 a, vec3 b, out vec3 q) {
    vec3 ab = b - a;
    vec3 ao = o - a;
    float len2 = dot(ab, ab);
    float k = dot(ab, dir);
    float denom = len2 - k * k; // |ab|² sin² of the angle to the ray
    float s = denom > 1e-12 * len2 ? (dot(ab, ao) - k * dot(ao, dir)) / denom : 0.0;
    q = s <= 0.0 ? a : (s >= 1.0 ? b : a + ab * s);
    float t = dot(q - o, dir);
    return vec2(length(o + dir * t - q), t);
}

// Ray-to-axis distance of segment i, or a large value if it does not exist.
float segment_distance(int i, vec3 o, vec3 dir) {
    if (i < 0 || i + 1 >= trail.points.length()) {
        return 1e30;
    }
    vec3 q;
    return closest_approach(o, dir, trail.points[i].xyz, trail.points[i + 1].xyz, q).x;
}

void main() {
    int i = gl_PrimitiveID;
    vec3 o = gl_ObjectRayOriginEXT;
    vec3 dir = gl_ObjectRayDirectionEXT;

    vec3 q;
    vec2 dt = closest_approach(o, dir, trail.points[i].xyz, trail.points[i + 1].xyz, q);
    float d = dt.x;
    float t_ray = dt.y;
    if (t_ray < gl_RayTminEXT || t_ray > gl_RayTmaxEXT) {
        return;
    }

    // Neighbouring segments' capsules overlap around their shared point.
    // Only the segment the ray passes closest to reports a hit, so the tube
    // is their union: one hit at the minimum distance, no seam and no
    // doubled overlap at a bend. Along a smooth trail that distance falls
    // and rises once, so the closest of the three is the closest of all.
    if (d > segment_distance(i - 1, o, dir) || d > segment_distance(i + 1, o, dir)) {
        return;
    }

    // Tracer fade value t, as the raster tracer fades: 1 at the ball, falling
    // to params.x at the trail's oldest point, by distance from the ball over
    // the trail's arc length (ball_pos.w).
    float fade_dist = pc.ball_pos.w > 0.0 ? pc.ball_pos.w : 50.0;
    float u = clamp(distance(q, pc.ball_pos.xyz) / fade_dist, 0.0, 1.0);
    float fade = 1.0 - u * (1.0 - pc.params.x);

    // Radius: the raster core's, tapered at the tip, but at least the
    // minimum on-screen width. A floor reflection's path from the camera is
    // the camera-to-floor distance plus t_ray.
    float pixel = pc.params.y * (distance(pc.camera_pos.xyz, o) + t_ray);
    float taper = min(fade / TIP_TAPER, 1.0);
    float r_core = TUBE_RADIUS * taper;
    float r_min = TUBE_MIN_RADIUS_PX * pixel;
    float radius = min(max(r_core, r_min), TUBE_MAX_RADIUS);
    if (d >= radius) {
        return;
    }
    float edge = clamp(max(TUBE_SOFTNESS * radius, pixel), 1e-6, radius);

    hit.height = q.y;
    hit.fade = fade;
    hit.rel_dist = d / radius;
    hit.rel_edge = edge / radius;
    // The tip tapers in width; where the width is held at the minimum, it
    // tapers in brightness instead (1 wherever the width can taper).
    hit.weight = max(TUBE_RADIUS, r_min) * taper / max(r_core, r_min);
    reportIntersectionEXT(t_ray, 0u);
}
